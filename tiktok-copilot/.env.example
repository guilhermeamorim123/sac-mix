# --- IA ---
ANTHROPIC_API_KEY=sk-ant-...
# Modelo do classificador. claude-opus-5 e o padrao.
# Para cortar custo em live de alto volume, troque por claude-haiku-4-5.
COPILOT_MODEL=claude-opus-5

# --- Live ---
# @ da conta que vai transmitir (sem o @ tambem funciona)
TIKTOK_USERNAME=@mixconecta

# --- Auto-envio no chat (Playwright) ---
# false = so sugere no painel. true = digita sozinho no chat da live.
AUTO_REPLY_ENABLED=false
# Teto de mensagens automaticas por minuto. Nao suba muito: cadencia
# robotica e o que dispara deteccao.
AUTO_REPLY_MAX_PER_MIN=4
# Porta do Chrome em modo debug (o vendedor loga na mao, ver README)
CHROME_CDP_URL=http://localhost:9222

# --- Replay (live gravada sendo reexibida) ---
# true = exige check-in de supervisor para liberar o auto-envio
REPLAY_MODE=false
SUPERVISOR_INTERVAL_MIN=15

# --- Persistencia ---
# sqlite  = tudo local, nao precisa de conta (bom pro primeiro teste)
# supabase = painel do Lovable le em tempo real
STORE_BACKEND=sqlite
SQLITE_PATH=copilot.db
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
# Identifica a loja no modo SaaS multi-tenant
SELLER_ID=mix-conecta
